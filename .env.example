# Copy to .env and fill in. Never commit .env.

# SEC EDGAR fair-access policy requires a descriptive User-Agent with a contact email.
# The EDGAR client refuses to start without this.
EDGAR_USER_AGENT="ethan_sense/0.1 (you@example.com)"

# Model provider. config/models.yaml `provider` names the production provider (openai);
# PRIMER_MODEL_PROVIDER overrides it locally (openai | anthropic). The matching key must
# be set or every role falls back to the deterministic template writer.
# The *_BASE_URL endpoints are the standard ones; point them at a proxy or compatible
# gateway if needed.
PRIMER_MODEL_PROVIDER=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Firecrawl (web search, scrape, parse, map, agent). Free tier: 1,000 credits.
FIRECRAWL_API_KEY=

# SAM.gov personal API key (Account Details page). Tens of calls per day.
SAM_GOV_API_KEY=

# Firecrawl concurrency: the free plan allows 2 concurrent requests (default 2).
FIRECRAWL_CONCURRENCY=2

# Financial Modeling Prep: only read when config/sources.yaml market_data.adapter is "fmp"
# (the stub adapter; the first paid swap for consensus, targets and ratings).
FMP_API_KEY=

# Optional tracing. When set, LangSmith tracing is on; otherwise a local JSONL trace is written.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=ethan_sense

# Optional: where golden reference primers live when they cannot be committed.
GOLDEN_DIR=docs/golden
